---
const categories = [
  { name: "日记", english: "Diary", path: "/diary/" },
  { name: "追星", english: "Fandom", path: "/fandom/" },
  { name: "游戏", english: "Games", path: "/games/" },
  { name: "旅行", english: "Travel", path: "/travel/" },
  { name: "书籍", english: "Books", path: "/books/" },
  { name: "影视", english: "Movies & TV", path: "/movies/" },
];
---

<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>yourloaive</title>
    <meta
      name="description"
      content="yourloaive — 一个记录生活与喜欢之物的小小空间。"
    />
  </head>

  <body>
    <header class="header">
      <a href="/" class="logo">yourloaive</a>

     <nav>
  {categories.map((category) => (
    <a href={category.path}>
      <span class="nav-chinese">{category.name}</span>
      <span class="nav-english">{category.english}</span>
    </a>
  ))}
</nav>
    </header>

    <main>
      <section class="hero">
        <p class="eyebrow">WELCOME TO MY LITTLE SPACE</p>

        <h1>
          Welcome to<br />
          <span>yourloaive.</span>
        </h1>

        <p class="intro">
          一个属于我的小小空间。<br />
          记录生活，也记录那些让我喜欢的东西。
        </p>
      </section>

      <section class="categories">
        <p class="section-label">CATEGORIES</p>

        <div class="category-list">
          {categories.map((category, index) => (
            <a href={category.path} class="category">
              <span class="number">
                {String(index + 1).padStart(2, "0")}
              </span>

             <div class="name">
  <span class="chinese">{category.name}</span>
  <span class="english">{category.english}</span>
</div>

<span class="arrow">↗</span>
            </a>
          ))}
        </div>
      </section>
    </main>

    <footer>
      <p>© 2026 yourloaive</p>
    </footer>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    background: #f7f6f2;
    color: #222;
    font-family:
      -apple-system,
      BlinkMacSystemFont,
      "Helvetica Neue",
      "Hiragino Sans GB",
      "PingFang SC",
      sans-serif;
  }

 .header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 32px 5vw;
}
  .logo {
    color: #222;
    text-decoration: none;
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

nav {
  display: flex;
  align-items: flex-start;
  gap: 30px;
}

nav a {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 4px;

  color: #333;
  text-decoration: none;

  transition:
    color 0.25s ease,
    transform 0.25s ease;
}

.nav-chinese {
  font-size: 14px;
  font-weight: 400;
  line-height: 1.2;
  white-space: nowrap;
}

.nav-english {
  color: #aaa;
  font-family: Arial, Helvetica, sans-serif;
  font-size: 8px;
  font-weight: 400;
  line-height: 1;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  white-space: nowrap;
}

nav a:hover {
  color: #888;
  transform: translateY(-2px);
}

nav a:hover .nav-english {
  color: #888;
}

  main {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 5vw;
  }

  .hero {
    min-height: 650px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 80px 0 120px;
  }

  .eyebrow,
  .section-label {
    margin: 0 0 28px;
    color: #999;
    font-size: 11px;
    letter-spacing: 0.18em;
  }

  h1 {
    margin: 0;
    font-size: clamp(58px, 10vw, 120px);
    line-height: 0.98;
    font-weight: 500;
    letter-spacing: -0.03em;
  }

  h1 span {
    color: #888;
  }

  .intro {
    margin-top: 48px;
    color: #777;
    font-size: 16px;
    line-height: 2;
  }

  .categories {
    padding: 80px 0 160px;
  }

  .category-list {
    border-top: 1px solid #d8d6d0;
  }

  .category {
    display: grid;
    grid-template-columns: 70px 1fr 40px;
    align-items: center;
    padding: 25px 0;
    border-bottom: 1px solid #d8d6d0;
    color: #222;
    text-decoration: none;
    transition:
      padding 0.25s ease,
      color 0.25s ease;
  }

  .category:hover {
    padding-left: 15px;
    color: #777;
  }

  .number {
    color: #aaa;
    font-size: 12px;
  }

  .name {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.chinese {
  font-size: 28px;
  font-weight: 400;
}

.english {
  color: #999;
  font-size: 12px;
  font-weight: 400;
  letter-spacing: 0.08em;
}

  .arrow {
    color: #999;
    font-size: 20px;
    text-align: right;
  }

  footer {
    padding: 30px 5vw;
    border-top: 1px solid #d8d6d0;
    color: #999;
    font-size: 12px;
  }

  @media (max-width: 700px) {
  .header {
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
    padding: 24px;
  }

  nav {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px 12px;
  }

  nav a {
    align-items: flex-start;
  }

  .nav-chinese {
    font-size: 13px;
  }

  .nav-english {
    font-size: 7px;
  }
}

    main {
      padding: 0 24px;
    }

    .hero {
      min-height: 600px;
      padding: 60px 0 100px;
    }

    h1 {
      font-size: clamp(52px, 16vw, 90px);
    }

    .category {
      grid-template-columns: 45px 1fr 30px;
    }

    .name {
      font-size: 23px;
    }

    footer {
      padding: 25px 24px;
    }
  }
</style>