---
import Layout from "../layouts/Layout.astro";

const categories = [
  {
    name: "日记",
    english: "Diary",
    path: "/diary/",
  },
  {
    name: "书籍",
    english: "Books",
    path: "/books/",
  },
];
---

<Layout
  title="yourloaive"
  description="yourloaive — 一个记录生活与喜欢之物的小小空间。"
>
  <section class="hero">
    <p class="eyebrow">WELCOME TO MY LITTLE SPACE</p>

    <h1>
      Welcome to<br />
      <span>yourloaive.</span>
    </h1>

    <p class="intro">
      一个属于我的小小空间。<br />
      记录生活，也记录那些让我喜欢的东西。
    </p>
  </section>

  <section class="categories">
    <p class="section-label">CATEGORIES</p>

    <div class="category-list">
      {categories.map((category, index) => (
        <a href={category.path} class="category">
          <span class="number">
            {String(index + 1).padStart(2, "0")}
          </span>

          <div class="name">
            <span class="chinese">{category.name}</span>
            <span class="english">{category.english}</span>
          </div>

          <span class="arrow">↗</span>
        </a>
      ))}
    </div>
  </section>
</Layout>

<style>
  .hero {
    min-height: 650px;

    display: flex;
    flex-direction: column;
    justify-content: center;

    padding: 80px 0 120px;
  }

  .eyebrow,
  .section-label {
    margin: 0 0 28px;

    color: #999;

    font-size: 11px;
    letter-spacing: 0.18em;
  }

  h1 {
    margin: 0;

    font-size: clamp(58px, 10vw, 120px);
    line-height: 0.98;

    font-weight: 500;
    letter-spacing: -0.03em;
  }

  h1 span {
    color: #888;
  }

  .intro {
    margin-top: 48px;

    color: #777;

    font-size: 16px;
    line-height: 2;
  }

  .categories {
    padding: 80px 0 160px;
  }

  .category-list {
    border-top: 1px solid #d8d6d0;
  }

  .category {
    display: grid;
    grid-template-columns: 70px 1fr 40px;

    align-items: center;

    padding: 25px 0;

    border-bottom: 1px solid #d8d6d0;

    color: #222;
    text-decoration: none;

    transition:
      padding 0.25s ease,
      color 0.25s ease;
  }

  .category:hover {
    padding-left: 15px;
    color: #777;
  }

  .number {
    color: #aaa;
    font-size: 12px;
  }

  .name {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .chinese {
    font-size: 28px;
    font-weight: 400;
  }

  .english {
    color: #999;

    font-size: 12px;
    font-weight: 400;

    letter-spacing: 0.08em;
  }

  .arrow {
    color: #999;
    font-size: 20px;
    text-align: right;
  }

  @media (max-width: 700px) {
    .hero {
      min-height: 600px;
      padding: 60px 0 100px;
    }

    h1 {
      font-size: clamp(52px, 16vw, 90px);
    }

    .category {
      grid-template-columns: 45px 1fr 30px;
    }
  }
</style>