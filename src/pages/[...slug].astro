---
import {
  getCollection,
  render,
  type CollectionEntry,
} from "astro:content";

import Layout from "../layouts/Layout.astro";

type Post = CollectionEntry<"posts">;

export async function getStaticPaths(): Promise<
  {
    params: { slug: string };
    props: { post: Post };
  }[]
> {
  const posts = await getCollection("posts");

 return posts
  .filter((post: Post) => !post.data.draft)
  .map((post: Post) => ({
      params: {
        slug: post.id,
      },
      props: {
        post,
      },
    }));
}

const { post } = Astro.props as {
  post: Post;
};

const { Content } = await render(post);
---

<Layout
  title={post.data.title}
  description={post.data.description ?? ""}
>
  <main class="post">
    <p class="category">
      {post.data.category}
    </p>

    <h1>{post.data.title}</h1>

    <time datetime={post.data.date.toISOString()}>
      {post.data.date.toLocaleDateString("zh-CN")}
    </time>

    {post.data.description && (
      <p class="description">
        {post.data.description}
      </p>
    )}

    <hr />

    <article class="content">
      <Content />
    </article>

    {post.data.tags && post.data.tags.length > 0 && (
      <div class="tags">
        {post.data.tags.map((tag: string) => (
          <span>#{tag}</span>
        ))}
      </div>
    )}
  </main>
</Layout>

<style>
  .post {
    max-width: 760px;
    margin: 0 auto;
    padding: 100px 0 150px;
  }

  .category {
    margin: 0 0 20px;

    color: #999;
    font-size: 11px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;

    font-size: clamp(42px, 7vw, 76px);
    line-height: 1.15;
    font-weight: 500;
    letter-spacing: -0.04em;
  }

  time {
    display: block;
    margin-top: 20px;

    color: #aaa;
    font-size: 12px;
  }

  .description {
    margin-top: 35px;

    color: #777;
    line-height: 2;
  }

  hr {
    margin: 60px 0;

    border: 0;
    border-top: 1px solid #d8d6d0;
  }

  .content {
    color: #333;
    font-size: 16px;
    line-height: 2;
  }

  .content :global(h1),
  .content :global(h2),
  .content :global(h3) {
    margin-top: 50px;
    margin-bottom: 20px;
    letter-spacing: -0.02em;
  }

  .content :global(p) {
    margin: 24px 0;
  }

  .content :global(img) {
    display: block;
    width: 100%;
    height: auto;
    margin: 40px 0;
  }

  .content :global(a) {
    color: inherit;
    text-underline-offset: 4px;
  }

  .content :global(blockquote) {
    margin: 40px 0;
    padding-left: 20px;

    border-left: 2px solid #d8d6d0;

    color: #777;
  }

  .content :global(ul),
  .content :global(ol) {
    padding-left: 25px;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;

    margin-top: 60px;
    padding-top: 25px;

    border-top: 1px solid #d8d6d0;

    color: #999;
    font-size: 12px;
  }

  @media (max-width: 700px) {
    .post {
      padding: 60px 0 100px;
    }

    .content {
      font-size: 15px;
    }
  }
</style>