---
const {
  title = "yourloaive",
  description = "一个属于我的小小空间。",
} = Astro.props;

const categories = [
  { name: "日记", english: "Diary", path: "/diary/" },
  { name: "书籍", english: "Books", path: "/books/" },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <meta name="generator" content={Astro.generator} />

    <title>{title} — yourloaive</title>

    <meta name="description" content={description} />
  </head>

  <body>
    <header class="header">
      <a href="/" class="logo">yourloaive</a>

      <nav>
        {categories.map((category) => (
          <a href={category.path}>
            <span class="nav-chinese">{category.name}</span>
            <span class="nav-english">{category.english}</span>
          </a>
        ))}
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <p>© 2026 yourloaive</p>
    </footer>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html),
  :global(body) {
    margin: 0;
    width: 100%;
    min-height: 100%;
  }

  :global(body) {
    background: #f7f6f2;
    color: #222;

    font-family:
      -apple-system,
      BlinkMacSystemFont,
      "Helvetica Neue",
      "Hiragino Sans GB",
      "PingFang SC",
      sans-serif;
  }

  .header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;

    padding: 32px 5vw;
  }

  .logo {
    color: #222;
    text-decoration: none;

    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  nav {
    display: flex;
    align-items: flex-start;
    gap: 30px;
  }

  nav a {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;

    color: #333;
    text-decoration: none;

    transition:
      color 0.25s ease,
      transform 0.25s ease;
  }

  .nav-chinese {
    font-size: 14px;
    font-weight: 400;
    line-height: 1.2;
    white-space: nowrap;
  }

  .nav-english {
    color: #aaa;

    font-family: Arial, Helvetica, sans-serif;
    font-size: 8px;
    font-weight: 400;
    line-height: 1;

    letter-spacing: 0.14em;
    text-transform: uppercase;

    white-space: nowrap;
  }

  nav a:hover {
    color: #888;
    transform: translateY(-2px);
  }

  nav a:hover .nav-english {
    color: #888;
  }

  main {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 5vw;
  }

  footer {
    padding: 30px 5vw;

    border-top: 1px solid #d8d6d0;

    color: #999;
    font-size: 12px;
  }

  @media (max-width: 700px) {
    .header {
      flex-direction: column;
      align-items: flex-start;
      gap: 24px;

      padding: 24px;
    }

    nav {
      width: 100%;

      display: grid;
      grid-template-columns: repeat(3, 1fr);

      gap: 18px 12px;
    }

    .nav-chinese {
      font-size: 13px;
    }

    .nav-english {
      font-size: 7px;
    }

    main {
      padding: 0 24px;
    }

    footer {
      padding: 25px 24px;
    }
  }
</style>