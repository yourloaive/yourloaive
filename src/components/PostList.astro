---
import {
  getCollection,
  type CollectionEntry,
} from "astro:content";

interface Props {
  category: "diary" |  "books" ;
}

const { category } = Astro.props;

type Post = CollectionEntry<"posts">;

const posts: Post[] = (await getCollection("posts"))
  .filter((post: Post) => {
    return post.data.category === category && !post.data.draft;
  })
  .sort((a: Post, b: Post) => {
    return b.data.date.valueOf() - a.data.date.valueOf();
  });
---

<section class="posts">
  {posts.length > 0 ? (
    <div class="post-list">
      {posts.map((post: Post) => (
        <a class="post-item" href={`/${post.id}/`}>
          <div class="post-date">
            {post.data.date.toLocaleDateString("zh-CN", {
              year: "numeric",
              month: "2-digit",
              day: "2-digit",
            })}
          </div>

          <div class="post-info">
            <h2>{post.data.title}</h2>

            {post.data.description && (
              <p>{post.data.description}</p>
            )}
          </div>

          <span class="arrow">→</span>
        </a>
      ))}
    </div>
  ) : (
    <p class="empty">暂时还没有文章。</p>
  )}
</section>

<style>
  .posts {
    padding: 20px 0 160px;
  }

  .post-list {
    border-top: 1px solid #d8d6d0;
  }

  .post-item {
    display: grid;
    grid-template-columns: 120px 1fr 30px;
    gap: 30px;
    align-items: center;

    padding: 28px 0;

    border-bottom: 1px solid #d8d6d0;

    color: #222;
    text-decoration: none;

    transition:
      padding 0.25s ease,
      color 0.25s ease;
  }

  .post-item:hover {
    padding-left: 10px;
    color: #777;
  }

  .post-date {
    color: #999;

    font-family: Arial, Helvetica, sans-serif;
    font-size: 11px;
    letter-spacing: 0.05em;
  }

  .post-info h2 {
    margin: 0;

    font-size: 20px;
    font-weight: 400;
    line-height: 1.5;
  }

  .post-info p {
    max-width: 600px;
    margin: 8px 0 0;

    color: #999;
    font-size: 13px;
    line-height: 1.8;
  }

  .arrow {
    color: #999;
    font-size: 18px;

    transition: transform 0.25s ease;
  }

  .post-item:hover .arrow {
    transform: translateX(5px);
  }

  .empty {
    padding: 40px 0;

    color: #999;
    font-size: 13px;
  }

  @media (max-width: 700px) {
    .post-item {
      grid-template-columns: 1fr 20px;
      gap: 10px;
    }

    .post-date {
      grid-column: 1 / -1;
    }

    .post-info h2 {
      font-size: 18px;
    }

    .post-info p {
      font-size: 12px;
    }
  }
</style>